---
import Site from '../layouts/Site.astro';
import SinglePage from '../components/SinglePage.astro';
import SolutionDetail from '../components/SolutionDetail.astro';
import { locales, legacyRoutes, solutionRoutes, href, anchorFor, translator, type Locale } from '../data/content';
export function getStaticPaths() {
  return locales.flatMap((lang) => [
    ...legacyRoutes.map((path) => ({
      params: { route: lang + (path ? '/' + path : '') },
      props: { lang, path },
    })),
    ...solutionRoutes.map((path) => ({ params: { route: lang + '/' + path }, props: { lang, path } })),
  ]);
}
const { lang, path } = Astro.props as { lang: Locale; path: string };
const t = translator(lang);
const target = href(lang) + (path ? '#' + anchorFor(path) : '');
const solutionId = path.startsWith('solutions/') ? path.slice('solutions/'.length) : '';
const isSolution = ['ai-solution-design', 'enterprise-digital-infrastructure', 'zero-trust-access-governance'].includes(solutionId);
const solutionTitle = {
  'ai-solution-design': t('AI 解決方案設計', 'AI solution design'),
  'enterprise-digital-infrastructure': t('企業數位基礎架構', 'Enterprise digital infrastructure'),
  'zero-trust-access-governance': t('零信任存取治理', 'Zero trust access governance'),
}[solutionId] ?? t('企業解決方案', 'Enterprise solution');
---

{
  isSolution ? (
    <Site
      lang={lang}
      path={path}
      singlePage={false}
      title={solutionTitle}
      description={t('Eryndex 智序科技企業解決方案規格與導入說明。', 'Eryndex enterprise solution capabilities and implementation approach.')}
    >
      <SolutionDetail lang={lang} id={solutionId} />
    </Site>
  ) : path ? (
    <html lang={lang === 'zh-tw' ? 'zh-Hant' : lang === 'zh-cn' ? 'zh-Hans' : 'en'}>
      <>
        <head>
          <>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta http-equiv="refresh" content={'0;url=' + target} />
            <meta name="robots" content="noindex" />
            <link rel="canonical" href={new URL(href(lang), Astro.site)} />
            <title>{t('前往 Eryndex', 'Continue to Eryndex')}</title>
          </>
        </head>
        <body>
          <p>
            <a href={target}>
              {t('前往首頁對應內容', 'Continue to this section on the home page')} →
            </a>
          </p>
        </body>
      </>
    </html>
  ) : (
    <Site
      lang={lang}
      title={t('企業軟體與工作系統設計', 'Enterprise software and work systems')}
      description={t(
        'Eryndex 智序科技以工作協作、資訊管理與存取治理，為企業建立一套清楚、可持續運作的工作系統。',
        'Eryndex brings work coordination, information management and access governance into one clear, sustainable business system.',
      )}
    >
      <SinglePage lang={lang} />
    </Site>
  )
}
