---
import Site from '../layouts/Site.astro';
import SinglePage from '../components/SinglePage.astro';
import { locales, legacyRoutes, href, anchorFor, translator, type Locale } from '../data/content';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    legacyRoutes.map((path) => ({
      params: { route: lang + (path ? '/' + path : '') },
      props: { lang, path },
    })),
  );
}
const { lang, path } = Astro.props as { lang: Locale; path: string };
const t = translator(lang);
const target = href(lang) + (path ? '#' + anchorFor(path) : '');
---

{
  path ? (
    <html lang={lang === 'zh-tw' ? 'zh-Hant' : lang === 'zh-cn' ? 'zh-Hans' : 'en'}>
      <>
        <head>
          <>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <meta http-equiv="refresh" content={'0;url=' + target} />
            <meta name="robots" content="noindex" />
            <link rel="canonical" href={new URL(href(lang), Astro.site)} />
            <title>{t('前往 Eryndex', 'Continue to Eryndex')}</title>
          </>
        </head>
        <body>
          <p>
            <a href={target}>
              {t('前往首頁對應內容', 'Continue to this section on the home page')} →
            </a>
          </p>
        </body>
      </>
    </html>
  ) : (
    <Site
      lang={lang}
      title={t('企業軟體與工作系統設計', 'Enterprise software and work systems')}
      description={t(
        'Eryndex 智序科技設計企業工作協作、資訊管理與存取治理系統，旗下產品包含 Space、Files 與 Shield。',
        'Eryndex designs systems for business collaboration, information management and access governance, including Space, Files and Shield.',
      )}
    >
      <SinglePage lang={lang} />
    </Site>
  )
}
