---
import { translator, type Locale } from '../data/content';
const { lang, id } = Astro.props as { lang: Locale; id: string };
const t = translator(lang);
const tasks = [
  t('確認專案範圍', 'Confirm project scope'),
  t('整理交接文件', 'Prepare handoff notes'),
  t('檢視首頁文案', 'Review homepage copy'),
];
const files = [
  t('品牌提案.pdf', 'Brand proposal.pdf'),
  t('交接清單.xlsx', 'Handoff checklist.xlsx'),
  t('合作合約.docx', 'Collaboration agreement.docx'),
];
const fileVersions = [
  [
    ['v3', t('2026 年 9 月 11 日 14:20', '11 Sep 2026, 14:20'), 'YL', t('調整首頁提案內容', 'Homepage proposal updated')],
    ['v2', t('2026 年 9 月 10 日 16:05', '10 Sep 2026, 16:05'), 'CW', t('補上品牌方向', 'Brand direction added')],
    ['v1', t('2026 年 9 月 8 日 09:30', '8 Sep 2026, 09:30'), 'YL', t('建立初始檔案', 'Initial file created')],
  ],
  [
    ['v2', t('2026 年 9 月 11 日 10:15', '11 Sep 2026, 10:15'), 'CW', t('更新負責人與期限', 'Owners and dates updated')],
    ['v1', t('2026 年 9 月 9 日 11:40', '9 Sep 2026, 11:40'), 'CW', t('建立交接欄位', 'Handoff fields created')],
  ],
  [
    ['v4', t('2026 年 9 月 11 日 09:45', '11 Sep 2026, 09:45'), 'YL', t('確認最終條款', 'Final terms reviewed')],
    ['v3', t('2026 年 9 月 10 日 13:25', '10 Sep 2026, 13:25'), 'CW', t('修訂服務範圍', 'Service scope revised')],
    ['v2', t('2026 年 9 月 9 日 15:10', '9 Sep 2026, 15:10'), 'YL', t('加入交付項目', 'Deliverables added')],
    ['v1', t('2026 年 9 月 7 日 10:00', '7 Sep 2026, 10:00'), 'YL', t('建立合約草稿', 'Agreement draft created')],
  ],
];
---

<div class={'software-demo ' + id} data-demo={id}>
  <div class="demo-top">
    <strong>Eryndex {id[0].toUpperCase() + id.slice(1)}</strong><span
      >{t('互動示意 · 範例資料', 'Interactive preview · Sample data')}</span
    ><span class="avatar">E</span>
  </div>
  {
    id === 'space' && (
      <div class="demo-body">
        <>
          <aside class="demo-sidebar">
            <>
              <span>{t('設計團隊', 'Design team')}</span>
              <button type="button" class="active" data-module-close>{t('專案', 'Projects')}</button>
              <button type="button" data-module-title={t('團隊知識', 'Team knowledge')} data-module-copy={t('把作業方式、決策背景與交接文件整理成團隊可以延續使用的知識。', 'Keep working practices, decision context and handoff notes in reusable team knowledge.')} data-module-items={JSON.stringify([t('品牌語氣與用字', 'Brand voice and language'), t('提案交接方式', 'Proposal handoff'), t('素材命名規則', 'Asset naming rules')])}>{t('團隊知識', 'Team knowledge')}</button>
              <button type="button" data-module-title={t('工作流程', 'Workflows')} data-module-copy={t('以清楚的狀態與條件串接指派、審核與通知，同時保留人工判斷。', 'Connect assignment, review and notifications with clear states while retaining human judgment.')} data-module-items={JSON.stringify([t('內容提交 → 指派負責人', 'Content submitted → Assign owner'), t('負責人審核 → 留下意見', 'Owner review → Record feedback'), t('核准發布 → 通知團隊', 'Approval → Notify team')])}>{t('工作流程', 'Workflows')}</button>
              <small>{t('春季品牌計畫', 'Spring brand project')}</small>
            </>
          </aside>
          <div class="demo-main">
            <>
              <div class="demo-title">
                <>
                  <div>
                    <>
                      <p class="eyebrow">{t('工作空間 / 專案', 'WORKSPACE / PROJECT')}</p>
                      <h3>{t('品牌更新計畫', 'Brand refresh')}</h3>
                    </>
                  </div>
                  <span class="avatar-group">YL · CW</span>
                </>
              </div>
              <p class="demo-hint">
                {t(
                  '勾選待處理任務以開始工作；再次勾選進行中的任務即可完成。',
                  'Check a to-do item to start it; check it again in progress to complete it.',
                )}
              </p>
              <div class="kanban">
                <>
                  <section data-task-column="todo">
                    <h4>
                      {t('待處理', 'To do')} <span>2</span>
                    </h4>
                    {tasks.slice(0, 2).map((name, i) => (
                      <div class="task" data-stage="todo">
                        <span class="task-tag">
                          {i === 0 ? t('規劃', 'Planning') : t('交接', 'Handoff')}
                        </span>
                        <label>
                          <input
                            type="checkbox"
                            data-task
                            data-complete={t('完成：', 'Complete: ')}
                            data-reopen={t('重新開啟：', 'Reopen: ')}
                            aria-label={t('開始：', 'Start: ') + name}
                          />
                          <span>{name}</span>
                        </label>
                        <p>
                          {i === 0 ? 'YL' : 'CW'} <span>{t('本週', 'This week')}</span>
                        </p>
                      </div>
                    ))}
                  </section>
                  <section data-task-column="progress">
                    <>
                      <h4>
                        {t('進行中', 'In progress')} <span>1</span>
                      </h4>
                      <div class="task" data-stage="progress">
                        <>
                          <span class="task-tag">{t('內容', 'Content')}</span>
                          <label>
                            <>
                              <input
                                type="checkbox"
                                data-task
                                data-complete={t('完成：', 'Complete: ')}
                                data-reopen={t('重新開啟：', 'Reopen: ')}
                                aria-label={t('完成：', 'Complete: ') + tasks[2]}
                              />
                              <span>{tasks[2]}</span>
                            </>
                          </label>
                          <p>
                            YL <span>{t('本週', 'This week')}</span>
                          </p>
                          <div class="task-progress">
                            <span />
                          </div>
                        </>
                      </div>
                    </>
                  </section>
                  <section class="completed-column" data-task-column="done">
                    <>
                      <h4>
                        {t('已完成', 'Done')} <span data-completed-count>1</span>
                      </h4>
                      <div class="task done" data-stage="done">
                        <>
                          <span class="task-tag">{t('研究', 'Research')}</span>
                          <label>
                            <input
                              type="checkbox"
                              data-task
                              data-complete={t('完成：', 'Complete: ')}
                              data-reopen={t('重新開啟：', 'Reopen: ')}
                              checked
                              aria-label={t('重新開啟：', 'Reopen: ') + t('彙整需求與訪談', 'Gather requirements')}
                            />
                            <span>{t('彙整需求與訪談', 'Gather requirements')}</span>
                          </label>
                          <p>
                            CW <span>✓</span>
                          </p>
                        </>
                      </div>
                    </>
                  </section>
                </>
              </div>
              <p
                class="demo-status"
                role="status"
                data-task-status
                data-started={t('已移至進行中：{task}', 'Moved to in progress: {task}')}
                data-completed={t('已完成：{task}', 'Completed: {task}')}
                data-reopened={t('已重新開啟：{task}', 'Reopened: {task}')}
              />
              <section class="demo-module" data-module-panel hidden>
                <p class="eyebrow">{t('功能示意', 'FEATURE PREVIEW')}</p>
                <h3 data-module-heading />
                <p data-module-copy />
                <div class="module-list" data-module-list />
              </section>
            </>
          </div>
        </>
      </div>
    )
  }
  {
    id === 'files' && (
      <div class="demo-body">
        <>
          <aside class="demo-sidebar">
            <>
              <span>{t('企業資料', 'Business information')}</span>
              <button type="button" class="active" data-module-close>{t('團隊檔案', 'Team files')}</button>
              <button type="button" data-module-title={t('分享連結', 'Shared links')} data-module-copy={t('集中檢視分享對象、權限與到期時間，避免連結長期留在外部。', 'Review recipients, permissions and expiry in one place so links do not remain external indefinitely.')} data-module-items={JSON.stringify([t('品牌提案.pdf · 3 天後到期', 'Brand proposal.pdf · Expires in 3 days'), t('交接清單.xlsx · 僅限組織內', 'Handoff checklist.xlsx · Organization only'), t('合作合約.docx · 明天到期', 'Collaboration agreement.docx · Expires tomorrow')])}>{t('分享連結', 'Shared links')}</button>
              <button type="button" data-module-title={t('備份與還原', 'Backup & restore')} data-module-copy={t('追蹤備份時間、保留點與還原演練，讓重要資料有可驗證的回復路徑。', 'Track backup times, restore points and recovery drills so important information has a verified path back.')} data-module-items={JSON.stringify([t('最近備份 · 今天 02:00', 'Latest backup · Today 02:00'), t('保留範圍 · 30 個每日還原點', 'Retention · 30 daily restore points'), t('還原演練 · 2026 年 9 月 8 日完成', 'Recovery drill · Completed 8 Sep 2026')])}>{t('備份與還原', 'Backup & restore')}</button>
              <small>{t('保存狀態：已同步', 'Preservation: Synced')}</small>
            </>
          </aside>
          <div class="demo-main">
            <>
              <div class="demo-title">
                <div>
                  <>
                    <p class="eyebrow">{t('企業資料 / 品牌專案', 'BUSINESS / BRAND PROJECT')}</p>
                    <h3>{t('一份資訊，完整脈絡。', 'One file. Its full history.')}</h3>
                  </>
                </div>
              </div>
              <label class="file-search">
                <>
                  <span>{t('搜尋檔案', 'Search files')}</span>
                  <input
                    type="search"
                    data-file-search
                    placeholder={t('輸入檔名', 'Type a filename')}
                  />
                </>
              </label>
              <div class="file-workspace">
                <>
                  <div class="file-list" role="group" aria-label={t('檔案列表', 'File list')}>
                    {files.map((name, i) => (
                      <button
                        class={'file-row ' + (i === 0 ? 'selected' : '')}
                        data-file
                        data-name={name}
                        data-version={[3, 2, 4][i]}
                        data-versions={JSON.stringify(fileVersions[i])}
                        aria-pressed={i === 0 ? 'true' : 'false'}
                      >
                        <span class="file-type">{['PDF', 'XLS', 'DOC'][i]}</span>
                        <span>
                          <strong>{name}</strong>
                          <small>{t('今天更新 · 團隊共享', 'Updated today · Team shared')}</small>
                        </span>
                        <span data-version-label>v{[3, 2, 4][i]}</span>
                      </button>
                    ))}
                    <p data-no-files hidden>
                      {t(
                        '找不到符合的檔案，請試試其他關鍵字。',
                        'No matching files. Try another search.',
                      )}
                    </p>
                  </div>
                  <aside class="version-panel">
                    <>
                      <p class="eyebrow">{t('版本紀錄', 'VERSION HISTORY')}</p>
                      <strong data-current-file>{files[0]}</strong>
                      <div class="version-current">
                        <span class="dot blue" /> {t('目前檢視', 'Viewing')}{' '}
                        <span data-current-version>v3</span>
                      </div>
                      <ol class="version-history" data-version-history aria-label={t('版本建立時間紀錄', 'Version creation timeline')}>
                        {fileVersions[0].map(([version, date, owner, note], index) => (
                          <li class={index === 0 ? 'active' : ''}>
                            <button type="button" data-history-version={version.slice(1)}>
                              <strong>{version}</strong><span>{date}</span><small>{owner} · {note}</small>
                            </button>
                          </li>
                        ))}
                      </ol>
                      <button
                        class="demo-button"
                        data-restore
                        data-label={t('回復前一版', 'Restore previous version', '恢复上一版本')}
                        data-min={t('目前已是最早版本', 'Already at the earliest version', '当前已是最早版本')}
                        data-message={t(
                          '目前檢視已從 {from} 回復為 {to}；歷史紀錄仍保留。',
                          'Viewing restored from {from} to {to}; history remains available.',
                          '当前查看已从 {from} 恢复为 {to}；历史记录仍保留。',
                        )}
                      >
                        {t('回復前一版', 'Restore previous version', '恢复上一版本')}
                      </button>
                      <p class="demo-status" data-file-status role="status" />
                    </>
                  </aside>
                </>
              </div>
              <section class="demo-module" data-module-panel hidden>
                <p class="eyebrow">{t('功能示意', 'FEATURE PREVIEW')}</p>
                <h3 data-module-heading />
                <p data-module-copy />
                <div class="module-list" data-module-list />
              </section>
            </>
          </div>
        </>
      </div>
    )
  }
  {
    id === 'shield' && (
      <div class="demo-body">
        <>
          <aside class="demo-sidebar">
            <>
              <span>{t('信任管理', 'Trust management')}</span>
              <button type="button" class="active" data-module-close>{t('存取政策', 'Access policies')}</button>
              <button type="button" data-module-title={t('身分與裝置', 'Identity & devices')} data-module-copy={t('檢視人員角色、最近使用裝置與驗證狀態，找出需要重新確認的存取。', 'Review roles, recent devices and verification state to identify access that needs attention.')} data-module-items={JSON.stringify([t('YL · 行銷管理員 · MacBook 符合條件', 'YL · Marketing admin · MacBook compliant'), t('CW · 內容編輯 · Windows 符合條件', 'CW · Content editor · Windows compliant'), t('KT · 外部協作者 · 未知裝置待驗證', 'KT · External collaborator · Unknown device')])}>{t('身分與裝置', 'Identity & devices')}</button>
              <button type="button" data-module-title={t('稽核紀錄', 'Audit records')} data-module-copy={t('依時間查看允許、阻擋與政策變更，保留每次判斷的原因。', 'Review allowed, blocked and policy-change events with the reason for each decision.')} data-module-items={JSON.stringify([t('09:18 · 允許存取 · YL', '09:18 · Access allowed · YL'), t('08:42 · 要求進一步驗證 · KT', '08:42 · Verification required · KT'), t('08:05 · 政策已更新 · CW', '08:05 · Policy updated · CW')])}>{t('稽核紀錄', 'Audit records')}</button>
              <small>{t('預設：依條件授權', 'Default: Conditional access')}</small>
            </>
          </aside>
          <div class="demo-main">
            <>
              <div class="demo-title">
                <>
                  <div>
                    <>
                      <p class="eyebrow">{t('政策 / 企業資料存取', 'POLICY / BUSINESS ACCESS')}</p>
                      <h3>{t('每次存取，都有依據。', 'Every access decision, explained.')}</h3>
                    </>
                  </div>
                  <span class="policy-live">{t('政策示意', 'Sample policy')}</span>
                </>
              </div>
              <div class="policy-layout">
                <>
                  <section>
                    <>
                      <p class="demo-hint">
                        {t(
                          '切換條件，查看政策如何判斷存取。',
                          'Change the conditions to see how the policy responds.',
                        )}
                      </p>
                      <div class="policy-condition">
                        <>
                          <span>
                            <>
                              <strong>{t('身分已驗證', 'Identity verified')}</strong>
                              <small>
                                {t('完成多因素驗證', 'Multifactor authentication completed')}
                              </small>
                            </>
                          </span>
                          <input
                            type="checkbox"
                            role="switch"
                            checked
                            data-policy
                            aria-label={t('身分已驗證', 'Identity verified')}
                          />
                        </>
                      </div>
                      <div class="policy-condition">
                        <>
                          <span>
                            <>
                              <strong>{t('裝置符合條件', 'Device meets policy')}</strong>
                              <small>
                                {t(
                                  '裝置狀態符合組織要求',
                                  'Device state meets organizational requirements',
                                )}
                              </small>
                            </>
                          </span>
                          <input
                            type="checkbox"
                            role="switch"
                            checked
                            data-policy
                            aria-label={t('裝置符合條件', 'Device meets policy')}
                          />
                        </>
                      </div>
                      <div
                        class="policy-decision"
                        data-decision
                        data-allow={t('允許存取', 'Access allowed')}
                        data-deny={t('需要進一步驗證', 'Further verification required')}
                        role="status"
                      >
                        {t('允許存取', 'Access allowed')}
                      </div>
                    </>
                  </section>
                  <aside class="audit-panel">
                    <>
                      <p class="eyebrow">{t('決策紀錄', 'DECISION RECORD')}</p>
                      <ol>
                        <>
                          <li>
                            {t('收到存取要求', 'Access requested')}
                            <small>{t('企業工作帳號', 'Business account')}</small>
                          </li>
                          <li>
                            {t('檢查身分與裝置', 'Check identity and device')}
                            <small>{t('套用企業資料政策', 'Apply business access policy')}</small>
                          </li>
                          <li>
                            {t('留下判斷依據', 'Record the decision')}
                            <small>{t('可供後續稽核檢視', 'Available for later review')}</small>
                          </li>
                        </>
                      </ol>
                    </>
                  </aside>
                </>
              </div>
              <section class="demo-module" data-module-panel hidden>
                <p class="eyebrow">{t('功能示意', 'FEATURE PREVIEW')}</p>
                <h3 data-module-heading />
                <p data-module-copy />
                <div class="module-list" data-module-list />
              </section>
            </>
          </div>
        </>
      </div>
    )
  }
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((demo) => {
    const primary = demo.querySelector<HTMLElement>('.demo-main')!;
    const module = demo.querySelector<HTMLElement>('[data-module-panel]')!;
    demo.querySelectorAll<HTMLButtonElement>('[data-module-title]').forEach((button) => {
      button.addEventListener('click', () => {
        demo.querySelectorAll('.demo-sidebar button').forEach((item) => item.classList.toggle('active', item === button));
        primary.classList.add('show-module');
        module.hidden = false;
        module.querySelector('[data-module-heading]')!.textContent = button.dataset.moduleTitle!;
        module.querySelector('[data-module-copy]')!.textContent = button.dataset.moduleCopy!;
        const list = module.querySelector<HTMLElement>('[data-module-list]')!;
        list.replaceChildren(...(JSON.parse(button.dataset.moduleItems!) as string[]).map((text, index) => {
          const item = document.createElement('button');
          item.type = 'button';
          item.innerHTML = '<span>0' + (index + 1) + '</span><strong></strong><em>→</em>';
          item.querySelector('strong')!.textContent = text;
          item.addEventListener('click', () => {
            list.querySelectorAll('button').forEach(row => row.classList.toggle('selected', row === item));
          });
          return item;
        }));
      });
    });
    demo.querySelector<HTMLButtonElement>('[data-module-close]')?.addEventListener('click', (event) => {
      demo.querySelectorAll('.demo-sidebar button').forEach((item) => item.classList.toggle('active', item === event.currentTarget));
      primary.classList.remove('show-module');
      module.hidden = true;
    });

    const updateCounts = () => demo.querySelectorAll<HTMLElement>('[data-task-column]').forEach((column) => {
      const total = column.querySelector('h4 span');
      if (total) total.textContent = String(column.querySelectorAll('.task').length);
    });
    demo.querySelectorAll<HTMLInputElement>('[data-task]').forEach((task) => task.addEventListener('change', () => {
      const card = task.closest<HTMLElement>('.task')!;
      const name = card.querySelector('label span')!.textContent!;
      const status = demo.querySelector<HTMLElement>('[data-task-status]')!;
      if (card.dataset.stage === 'todo') {
        card.dataset.stage = 'progress';
        task.checked = false;
        task.setAttribute('aria-label', task.dataset.complete! + name);
        const progress = document.createElement('div');
        progress.className = 'task-progress';
        progress.append(document.createElement('span'));
        card.append(progress);
        demo.querySelector('[data-task-column="progress"]')!.append(card);
        status.textContent = status.dataset.started!.replace('{task}', name);
      } else if (card.dataset.stage === 'progress') {
        card.dataset.stage = 'done';
        card.classList.add('done');
        task.checked = true;
        task.setAttribute('aria-label', task.dataset.reopen! + name);
        card.querySelector('.task-progress')?.remove();
        demo.querySelector('[data-task-column="done"]')!.append(card);
        status.textContent = status.dataset.completed!.replace('{task}', name);
      } else {
        card.dataset.stage = 'progress';
        card.classList.remove('done');
        task.checked = false;
        task.setAttribute('aria-label', task.dataset.complete! + name);
        const progress = document.createElement('div');
        progress.className = 'task-progress';
        progress.append(document.createElement('span'));
        card.append(progress);
        demo.querySelector('[data-task-column="progress"]')!.append(card);
        status.textContent = status.dataset.reopened!.replace('{task}', name);
      }
      updateCounts();
      task.focus();
    }));

    const history = demo.querySelector<HTMLOListElement>('[data-version-history]');
    const showHistory = (file: HTMLButtonElement, focusVersion?: string) => {
      const versions = JSON.parse(file.dataset.versions!) as string[][];
      const current = Number(file.dataset.version);
      demo.querySelector('[data-current-file]')!.textContent = file.dataset.name!;
      demo.querySelector('[data-current-version]')!.textContent = 'v' + current;
      history!.replaceChildren(...versions.map(([version, date, owner, note]) => {
        const item = document.createElement('li');
        item.classList.toggle('active', Number(version.slice(1)) === current);
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.historyVersion = version.slice(1);
        const strong = document.createElement('strong');
        strong.textContent = version;
        const span = document.createElement('span');
        span.textContent = date;
        const small = document.createElement('small');
        small.textContent = owner + ' · ' + note;
        button.append(strong, span, small);
        item.append(button);
        return item;
      }));
      const restore = demo.querySelector<HTMLButtonElement>('[data-restore]')!;
      restore.disabled = current <= 1;
      restore.textContent = current <= 1 ? restore.dataset.min! : restore.dataset.label!;
      if (focusVersion) {
        history!.querySelector<HTMLButtonElement>(`[data-history-version="${focusVersion}"]`)?.focus();
      }
    };
    history?.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-history-version]');
      if (!button) return;
      const file = demo.querySelector<HTMLButtonElement>('[data-file][aria-pressed="true"]')!;
      const version = button.dataset.historyVersion!;
      file.dataset.version = version;
      file.querySelector('[data-version-label]')!.textContent = 'v' + version;
      showHistory(file, version);
      demo.querySelector('[data-file-status]')!.textContent = '';
    });
    const search = demo.querySelector<HTMLInputElement>('[data-file-search]');
    search?.addEventListener('input', () => {
      let visible = 0;
      demo.querySelectorAll<HTMLButtonElement>('[data-file]').forEach((file) => {
        file.hidden = !file.dataset.name!.toLowerCase().includes(search.value.trim().toLowerCase());
        if (!file.hidden) visible++;
      });
      demo.querySelector<HTMLElement>('[data-no-files]')!.hidden = visible > 0;
    });
    demo.querySelectorAll<HTMLButtonElement>('[data-file]').forEach((file) =>
      file.addEventListener('click', () => {
        demo.querySelectorAll('[data-file]').forEach((f) => {
          f.classList.remove('selected');
          f.setAttribute('aria-pressed', 'false');
        });
        file.classList.add('selected');
        file.setAttribute('aria-pressed', 'true');
        showHistory(file);
        demo.querySelector('[data-file-status]')!.textContent = '';
      }),
    );
    demo.querySelector<HTMLButtonElement>('[data-restore]')?.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const selected = demo.querySelector<HTMLButtonElement>('[data-file][aria-pressed="true"]')!;
      const from = Number(selected.dataset.version);
      if (from <= 1) return;
      const to = from - 1;
      selected.dataset.version = String(to);
      selected.querySelector('[data-version-label]')!.textContent = 'v' + to;
      showHistory(selected);
      demo.querySelector('[data-file-status]')!.textContent = button.dataset.message!
        .replace('{from}', 'v' + from)
        .replace('{to}', 'v' + to);
    });
    demo.querySelectorAll<HTMLInputElement>('[data-policy]').forEach((input) =>
      input.addEventListener('change', () => {
        const all = [...demo.querySelectorAll<HTMLInputElement>('[data-policy]')].every(
          (i) => i.checked,
        );
        const decision = demo.querySelector<HTMLElement>('[data-decision]')!;
        decision.textContent = all ? decision.dataset.allow! : decision.dataset.deny!;
        decision.classList.toggle('requires-review', !all);
      }),
    );
  });
</script>
