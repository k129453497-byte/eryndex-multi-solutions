---
import { asset, translator, type Locale } from '../data/content';
const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);
---

<section class="hero">
  <div class="hero-field" aria-hidden="true">
    <span class="field-line field-line-a"></span>
    <span class="field-line field-line-b"></span>
    <span class="field-node field-node-a"></span>
    <span class="field-node field-node-b"></span>
    <span class="field-node field-node-c"></span>
  </div>
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">ERYNDEX 智序科技 · ENTERPRISE SOFTWARE · TAIWAN</p>
      <h1>
        {t('建立清楚、可靠的', 'Clear, reliable systems')}<br />
        <em>{t('企業工作系統。', 'for how business works.')}</em>
      </h1>
      <p class="hero-description">
        {t(
          '智序科技提供企業軟體規劃、系統設計與導入服務，協助組織整理工作流程、重要資訊與存取治理。',
          'Eryndex plans, designs and implements enterprise software that brings structure to workflows, information and access governance.',
        )}
      </p>
      <div class="hero-actions">
        <a class="button" href="#about">{t('公司與服務', 'Company and services')} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#contact">{t('聯絡我們', 'Contact us')} →</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="system-orbit orbit-a"><span></span><span></span></div>
      <div class="system-orbit orbit-b"><span></span><span></span></div>
      <div class="system-orbit orbit-c"><span></span><span></span></div>
      <div class="system-grid"></div>
      <div class="system-core">
        <span class="core-halo"></span>
        <img src={asset('web/logo-72.webp')} alt="" width="88" height="88" />
      </div>
      <span class="signal signal-work">WORK</span>
      <span class="signal signal-info">INFORMATION</span>
      <span class="signal signal-trust">TRUST</span>
    </div>
  </div>
  <div class="hero-foot">
    <span>{t('企業軟體與工作系統設計', 'ENTERPRISE SOFTWARE AND WORK SYSTEMS')}</span>
    <a href="#about">{t('向下探索', 'Explore below')} ↓</a>
  </div>
</section>
