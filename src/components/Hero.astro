---
import { asset, translator, type Locale } from '../data/content';
const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);
---

<section class="hero">
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">ERYNDEX 智序科技 · ENTERPRISE WORK SYSTEMS</p>
      <h1>
        {t('把企業每天的工作，', 'Turn everyday business work')}<br />
        <em>{t('整理成可以持續運作的系統。', 'into a system built to last.')}</em>
      </h1>
      <p class="hero-description">
        {t(
          '從工作協作、資訊管理到存取治理，智序科技將分散的流程與管理責任，整理成一套清楚的企業運作方法。',
          'From work coordination and information management to access governance, Eryndex turns fragmented processes and responsibilities into one clear way for business to operate.',
        )}
      </p>
      <div class="hero-actions">
        <a class="button" href="#about">{t('認識智序科技', 'About Eryndex')} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#products">{t('了解企業系統', 'Explore the business system')} →</a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="system-orbit orbit-a"><span></span><span></span></div>
      <div class="system-orbit orbit-b"><span></span><span></span></div>
      <div class="system-orbit orbit-c"><span></span><span></span></div>
      <div class="system-grid"></div>
      <div class="system-core">
        <span class="core-halo"></span>
        <img src={asset('web/logo-72.webp')} alt="" width="88" height="88" />
      </div>
      <span class="signal signal-work">WORK</span>
      <span class="signal signal-info">INFORMATION</span>
      <span class="signal signal-trust">TRUST</span>
    </div>
  </div>
  <div class="hero-foot">
    <span>{t('企業軟體與工作系統設計', 'ENTERPRISE SOFTWARE AND WORK SYSTEMS')}</span>
    <a href="#about">{t('向下探索', 'Explore below')} ↓</a>
  </div>
</section>
