---
import { asset, translator, type Locale } from '../data/content';
const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);
---

<section class="hero">
  <video
    class="hero-video-bg"
    src={asset('web/hero-company.mp4')}
    poster={asset('web/hero-company.jpg')}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  ></video>
  <div class="hero-video-shade" aria-hidden="true"></div>
  <div class="hero-field" aria-hidden="true">
    <span class="field-line field-line-a"></span>
    <span class="field-line field-line-b"></span>
  </div>
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">ERYNDEX 智序科技 · ENTERPRISE SOFTWARE · TAIWAN</p>
      <h1>
        Clarity You Can Trust.<br />
        <em>{t('為企業打造清楚可靠的工作系統。', 'Clear, reliable work systems for business.')}</em>
      </h1>
      <p class="hero-description">
        {t(
          '企業軟體規劃・系統設計・導入服務——\n盤點資訊資產，治理身分存取，優化工作流程。',
          'Enterprise software planning, system design and implementation—\norganizing information assets, governing identity and access, and improving workflows.',
        )}
      </p>
      <div class="hero-actions">
        <a class="button" href="#about">{t('探索服務', 'Explore services')} <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#contact">{t('聯絡我們', 'Contact us')} →</a>
      </div>
    </div>

  </div>
  <div class="hero-foot">
    <span>{t('企業軟體與工作系統設計', 'ENTERPRISE SOFTWARE AND WORK SYSTEMS')}</span>
    <a href="#about">{t('向下探索', 'Explore below')} ↓</a>
  </div>
</section>
