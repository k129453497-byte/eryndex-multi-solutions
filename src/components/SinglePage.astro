---
import { content, translator, type Locale } from '../data/content';
import Hero from './Hero.astro';
import MasterImage from './MasterImage.astro';
import Legal from './Legal.astro';
import '../styles/single-page.css';

const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);
const { products } = content(lang);

const operatingPrinciples = [
  [
    t('從真實工作開始', 'Begin with real work'),
    t(
      '先理解企業每天如何協作、保存資訊與管理存取，再決定系統應該扮演的角色。',
      'Understand how the business collaborates, preserves information and controls access before deciding what the system should do.',
    ),
  ],
  [
    t('建立清楚的責任', 'Give every system a clear responsibility'),
    t(
      '讓工作、資訊與信任各有明確邊界，減少重複工具與模糊的管理責任。',
      'Give work, information and trust clear boundaries, reducing duplicated tools and unclear ownership.',
    ),
  ],
  [
    t('讓改變能夠持續', 'Make change sustainable'),
    t(
      '把導入、訓練與後續調整一起納入設計，讓系統成為可以持續使用的方法。',
      'Design implementation, training and ongoing improvement together so the system becomes a lasting way of working.',
    ),
  ],
];

const companyFacts = [
  [t('公司名稱', 'Company'), t('Eryndex 智序科技', 'Eryndex')],
  [
    t('業務方向', 'Business focus'),
    t('企業軟體與工作系統設計', 'Enterprise software and work systems'),
  ],
  [
    t('產品領域', 'Product fields'),
    t(
      '工作協作、資訊管理、存取治理',
      'Collaboration, information management and access governance',
    ),
  ],
  [t('服務地區', 'Service region'), t('台灣', 'Taiwan')],
  [t('聯絡方式', 'Contact'), 'contact@eryndex.com'],
];
---

<Hero lang={lang} />

<div class="corporate-story">
  <section id="about" class="company-intro wrap story-section">
    <p class="eyebrow">ABOUT ERYNDEX / 智序科技</p>
    <div class="company-intro-grid">
      <h2>
        {t('我們設計的，\n是企業每天都能使用的系統。', 'We design systems\nfor everyday business.')}
      </h2>
      <div class="company-intro-copy">
        <p class="lead">
          {
            t(
              'Eryndex 智序科技專注於企業工作協作、資訊管理與存取治理系統的設計與開發。我們從真實的工作情境出發，把分散的流程、重要資訊與管理規則，整理成清楚、可以持續運作的方法。',
              'Eryndex designs and develops systems for business collaboration, information management and access governance. We begin with real working situations and turn fragmented processes, important information and management rules into clear, sustainable ways of working.',
            )
          }
        </p>
        <p>
          {
            t(
              '科技不應讓企業增加更多維護負擔。它應該讓責任更清楚、交接更連續，也讓重要決策保留可以理解與檢視的依據。',
              'Technology should not create more maintenance overhead. It should clarify responsibility, make handoffs continuous and keep important decisions understandable and reviewable.',
            )
          }
        </p>
      </div>
    </div>
  </section>

  <section class="business-problem story-section">
    <div class="wrap business-problem-inner">
      <p class="eyebrow">THE WORK BEHIND EVERY BUSINESS</p>
      <p class="statement">
        {
          t(
            '工作散落在不同工具裡，檔案缺少一致的保存方式，權限也隨著時間逐漸失去脈絡。企業真正需要的，不是再增加一套孤立的工具，而是讓每天的工作重新連成一個整體。',
            'Work becomes scattered across tools, files lose a dependable way to be preserved and access drifts out of context. Businesses do not need another isolated tool. They need everyday work to become connected again.',
          )
        }
      </p>
    </div>
  </section>

  <section id="products" class="product-system wrap story-section">
    <header class="system-heading">
      <div>
        <p class="eyebrow">ONE SYSTEM · THREE RESPONSIBILITIES</p>
        <h2>
          {
            t(
              '工作、資訊與信任，\n形成同一套企業脈絡。',
              'Work, information and trust.\nOne business context.',
            )
          }
        </h2>
      </div>
      <p class="lead">
        {
          t(
            '三項產品各自承擔清楚的責任，也能在企業需要時彼此連結。',
            'Three products with distinct responsibilities, designed to connect when the business needs them to.',
          )
        }
      </p>
    </header>

    <div class="system-flow" aria-label={t('Eryndex 產品體系', 'Eryndex product system')}>
      {
        products.map((product, index) => (
          <article id={'products-' + product.id} class={'system-product ' + product.accent}>
            <div class="system-product-art" aria-hidden="true">
              <MasterImage
                kind={product.id as 'space' | 'files' | 'shield'}
                alt=""
                sizes="(max-width: 760px) 100vw, 34vw"
              />
            </div>
            <div class="system-product-copy">
              <span class="product-number">0{index + 1}</span>
              <p class="product-category">{product.category}</p>
              <h3>{product.name}</h3>
              <h4>{product.line}</h4>
              <p>{product.desc}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="system-summary">
      {
        t(
          'Space 整理工作，Files 保存資訊，Shield 管理信任。它們不是三個彼此競爭的工具，而是 Eryndex 對企業運作提出的三項清楚責任。',
          'Space organizes work, Files preserves information and Shield governs trust. They are not competing tools, but three clear responsibilities within the Eryndex approach to business operations.',
        )
      }
    </p>
  </section>

  <section id="approach" class="approach-section story-section">
    <div class="wrap">
      <header class="approach-heading">
        <p class="eyebrow">HOW WE WORK</p>
        <h2>
          {
            t(
              '先理解，再建立；\n先能運作，再逐步連結。',
              'Understand first. Build with purpose.\nConnect when it is ready.',
            )
          }
        </h2>
      </header>
      <ol class="approach-list">
        {
          operatingPrinciples.map(([title, description], index) => (
            <li>
              <>
                <span>0{index + 1}</span>
                <h3>{title}</h3>
                <p>{description}</p>
              </>
            </li>
          ))
        }
      </ol>
      <div class="services-note">
        <p class="eyebrow">ERYNDEX SERVICES</p>
        <h3>
          {
            t(
              '從規劃、導入到持續調整。',
              'From planning and implementation to ongoing improvement.',
            )
          }
        </h3>
        <p>
          {
            t(
              'Eryndex 提供系統規劃、初始設定、資料遷移、工作流程整理、使用者訓練與維護支援。實際範圍會依企業環境與需求確認。',
              'Eryndex provides system planning, initial configuration, data migration, workflow design, user training and maintenance support. Scope is agreed around each business environment and need.',
            )
          }
        </p>
      </div>
    </div>
  </section>

  <section id="company" class="company-profile wrap story-section">
    <div class="profile-heading">
      <p class="eyebrow">COMPANY PROFILE</p>
      <h2>
        {
          t(
            '清楚說明我們是誰，\n也說明我們負責什麼。',
            'Clear about who we are\nand what we are responsible for.',
          )
        }
      </h2>
    </div>
    <dl class="company-facts">
      {
        companyFacts.map(([term, description]) => (
          <div>
            <>
              <dt>{term}</dt>
              <dd>
                {description === 'contact@eryndex.com' ? (
                  <a href="mailto:contact@eryndex.com">{description} ↗</a>
                ) : (
                  description
                )}
              </dd>
            </>
          </div>
        ))
      }
    </dl>
    <p class="profile-note">
      {
        t(
          '本網站用於介紹 Eryndex 的公司方向、產品體系與服務內容。對外合作、產品範圍與專案條件，以雙方正式確認的文件為準。',
          'This website introduces the Eryndex company direction, product system and services. External cooperation, product scope and project terms are subject to formally agreed documentation.',
        )
      }
    </p>
  </section>

  <section id="contact" class="contact-statement story-section">
    <div class="wrap contact-statement-inner">
      <div>
        <p class="eyebrow">CONTACT ERYNDEX</p><h2>{t('與智序科技聯絡。', 'Contact Eryndex.')}</h2>
      </div>
      <div>
        <p class="lead">
          {
            t(
              '若需要公司、產品或合作相關資訊，歡迎透過官方信箱與我們聯絡。',
              'For company, product or partnership information, contact us through our official email address.',
            )
          }
        </p>
        <a class="contact-address" href="mailto:contact@eryndex.com">contact@eryndex.com ↗</a>
        <p class="contact-region">Taiwan · Asia/Taipei</p>
      </div>
    </div>
  </section>

  <section class="wrap corporate-legal" aria-label={t('網站政策', 'Website policies')}>
    {
      ['privacy', 'terms'].map((kind) => (
        <details id={kind}>
          <summary>
            <>
              <span>
                {kind === 'privacy'
                  ? t('隱私權說明', 'Privacy notice')
                  : t('網站使用條款', 'Website terms')}
              </span>
              <span aria-hidden="true">＋</span>
            </>
          </summary>
          <Legal lang={lang} kind={kind} embedded />
        </details>
      ))
    }
  </section>
</div>

<script>
  function revealAnchor() {
    if (!location.hash) return;
    let id: string;
    try {
      id = decodeURIComponent(location.hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);
    if (!target) return;
    let node: HTMLElement | null = target;
    while (node) {
      if (node instanceof HTMLDetailsElement) node.open = true;
      node = node.parentElement;
    }
    requestAnimationFrame(() =>
      target.scrollIntoView({
        block: 'start',
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
      }),
    );
  }
  window.addEventListener('hashchange', revealAnchor);
  if (location.hash) revealAnchor();
</script>
