---
import { translator, type Locale } from '../data/content';
import Hero from './Hero.astro';
import '../styles/single-page.css';

const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);

const values = [
  [t('企業系統設計', 'ENTERPRISE SYSTEM DESIGN'), t('企業軟體設計', 'Enterprise software'), t('以實際營運需求規劃系統與工作流程。', 'Systems and workflows planned around real operating needs.')],
  [t('導入與啟用', 'IMPLEMENTATION & ENABLEMENT'), t('系統導入服務', 'Implementation services'), t('從需求釐清、資料遷移到教育訓練。', 'From discovery and migration to user enablement.')],
  [t('持續營運', 'ONGOING OPERATIONS'), t('持續維護支援', 'Ongoing support'), t('協助系統穩定運作並因應組織變化。', 'Keeping systems reliable as organizations evolve.')],
];

const capabilities = [
  [t('工作協作', 'Work coordination'), t('整理任務、責任、交接與決策，讓團隊知道現在發生什麼，以及下一步由誰推進。', 'Organize tasks, ownership, handoffs and decisions so teams know what is happening and who moves next.')],
  [t('資訊管理', 'Information management'), t('建立一致的保存方式與版本脈絡，讓重要資訊能被找到、理解並持續使用。', 'Create a consistent record and version context so important information can be found, understood and reused.')],
  [t('存取治理', 'Access governance'), t('把身分、權限、核准與稽核放進清楚的管理流程，讓信任有依據。', 'Place identity, permission, approval and audit into a clear management process so trust has evidence.')],
];

const process = [
  [t('理解現況', 'Understand the current state'), t('從真實工作、現有工具與管理責任開始，釐清真正需要改善的問題。', 'Begin with real work, existing tools and management ownership to identify what actually needs improvement.')],
  [t('建立脈絡', 'Build the operating context'), t('把流程、資訊與治理原則整理成團隊能理解、可以執行的系統。', 'Turn processes, information and governance principles into a system teams can understand and use.')],
  [t('持續運作', 'Make it sustainable'), t('透過導入、訓練與後續調整，讓新的工作方式穩定進入日常。', 'Use implementation, training and ongoing refinement to make the new way of working part of daily operations.')],
];

---

<Hero lang={lang} />

<main class="corporate-site">
  <section class="value-strip" aria-label={t('Eryndex 核心價值', 'Eryndex core values')}>
    <div class="wrap value-strip-grid">
      {values.map(([category, title, description], index) => (
        <article>
          <header><span>{category}</span><b>0{index + 1}</b></header>
          <h2>{title}</h2>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="about" class="about-scene wrap scene">
    <div class="scene-label"><span>ABOUT ERYNDEX</span><span>{t('關於智序科技', 'About Eryndex')}</span></div>
    <div class="about-layout">
        <h2>{t('以企業每天的工作，\n作為系統設計的起點。', 'Enterprise systems designed around the work people actually do.')}</h2>
      <div class="about-copy">
        <p class="lead">{t('Eryndex 智序科技是一家位於台灣的企業軟體與工作系統設計公司。', 'Eryndex is a Taiwan-based enterprise software and work systems company.')}</p>
        <p>{t('我們協助企業釐清流程、資訊與管理責任，並將需求落實為能被團隊使用、管理與持續維護的數位系統。服務涵蓋系統規劃、導入、資料遷移、訓練與後續支援。', 'We help organizations clarify processes, information and management ownership, then turn those requirements into digital systems teams can use, govern and maintain. Services include planning, implementation, data migration, training and ongoing support.')}</p>
        <div class="about-meta"><span>{t('服務地區', 'REGION')} · TAIWAN</span><span>{t('業務類型', 'FOCUS')} · B2B SOFTWARE</span></div>
      </div>
    </div>
  </section>

  <section id="products" class="system-scene scene">
    <span id="products-space" class="legacy-anchor" aria-hidden="true"></span>
    <span id="products-files" class="legacy-anchor" aria-hidden="true"></span>
    <span id="products-shield" class="legacy-anchor" aria-hidden="true"></span>
    <div class="wrap system-layout">
      <div class="system-intro">
        <div class="system-title">
          <p class="eyebrow">CORE CAPABILITIES</p>
          <h2>{t('三項能力，\n支撐一套企業系統。', 'Three capabilities.\nOne enterprise system.')}</h2>
        </div>
        <p class="lead">{t('從日常協作、資訊保存到權限管理，智序科技以一致的系統觀點協助企業建立可持續的工作方式。', 'From daily collaboration and information continuity to permission management, Eryndex builds sustainable ways of working through one consistent system perspective.')}</p>
      </div>
      <div class="capability-stack">
        {capabilities.map(([title, description], index) => (
          <article tabindex="0">
            <div class="capability-icon" aria-hidden="true">
              {index === 0 ? (
                <svg viewBox="0 0 24 24"><path d="M4 7h6M14 7h6M7 4v6M17 4v6M4 17h6M14 17h6M7 14v6M17 14v6M10 7h4v10h-4z" /></svg>
              ) : index === 1 ? (
                <svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v5h5M9 12h6M9 16h6" /></svg>
              ) : (
                <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6zM9 12l2 2 4-4" /></svg>
              )}
            </div>
            <div class="capability-copy"><h3><span>0{index + 1}.</span> {title}</h3><p>{description}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="approach" class="process-scene wrap scene">
    <header class="scene-heading">
      <div><p class="eyebrow">DELIVERY MODEL</p><h2>{t('從需求確認，\n到系統穩定運作。', 'From confirmed requirements\nto reliable operation.')}</h2></div>
      <p>{t('我們不以功能清單開始，而是先確認工作如何發生、資訊如何流動，以及誰需要承擔管理責任。', 'We do not begin with a feature list. We first understand how work happens, how information moves and where management responsibility belongs.')}</p>
    </header>
    <ol class="process-list">
      {process.map(([title, description], index) => (
        <li><span>0{index + 1}</span><h3>{title}</h3><p>{description}</p></li>
      ))}
    </ol>
  </section>

  <section id="contact" class="contact-scene scene">
    <div class="wrap contact-layout">
      <div><p class="eyebrow">CONTACT ERYNDEX</p><h2>{t('與智序科技聯絡。', 'Contact Eryndex.')}</h2></div>
      <div><p>{t('企業合作、系統規劃或公司資料需求，歡迎透過官方信箱與我們聯絡。', 'For business partnerships, system planning or company information, contact us through our official email address.')}</p><a href="mailto:contact@eryndex.com">contact@eryndex.com ↗</a><span>Eryndex 智序科技 · Taiwan · Asia/Taipei</span></div>
    </div>
  </section>

</main>

<script>
  function revealAnchor() {
    if (!location.hash) return;
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let node: HTMLElement | null = target;
    while (node) { if (node instanceof HTMLDetailsElement) node.open = true; node = node.parentElement; }
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }
  addEventListener('hashchange', revealAnchor);
  revealAnchor();
</script>
