---
import { translator, type Locale } from '../data/content';
import Hero from './Hero.astro';
import MasterImage from './MasterImage.astro';
import Legal from './Legal.astro';
import '../styles/single-page.css';

const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);

const values = [
  [t('工作更清楚', 'Clearer work'), t('讓責任、進度與交接都有一致脈絡。', 'Give responsibility, progress and handoffs one shared context.')],
  [t('資訊能延續', 'Information that lasts'), t('讓重要資料保留版本、來源與可追溯性。', 'Preserve version, origin and traceability for important information.')],
  [t('治理可落實', 'Governance in practice'), t('讓存取、核准與管理規則進入日常工作。', 'Bring access, approval and governance into everyday work.')],
];

const capabilities = [
  [t('工作協作', 'Work coordination'), t('整理任務、責任、交接與決策，讓團隊知道現在發生什麼，以及下一步由誰推進。', 'Organize tasks, ownership, handoffs and decisions so teams know what is happening and who moves next.')],
  [t('資訊管理', 'Information management'), t('建立一致的保存方式與版本脈絡，讓重要資訊能被找到、理解並持續使用。', 'Create a consistent record and version context so important information can be found, understood and reused.')],
  [t('存取治理', 'Access governance'), t('把身分、權限、核准與稽核放進清楚的管理流程，讓信任有依據。', 'Place identity, permission, approval and audit into a clear management process so trust has evidence.')],
];

const process = [
  [t('理解現況', 'Understand the current state'), t('從真實工作、現有工具與管理責任開始，釐清真正需要改善的問題。', 'Begin with real work, existing tools and management ownership to identify what actually needs improvement.')],
  [t('建立脈絡', 'Build the operating context'), t('把流程、資訊與治理原則整理成團隊能理解、可以執行的系統。', 'Turn processes, information and governance principles into a system teams can understand and use.')],
  [t('持續運作', 'Make it sustainable'), t('透過導入、訓練與後續調整，讓新的工作方式穩定進入日常。', 'Use implementation, training and ongoing refinement to make the new way of working part of daily operations.')],
];

const companyFacts = [
  [t('公司名稱', 'Company'), t('Eryndex 智序科技', 'Eryndex')],
  [t('業務方向', 'Business focus'), t('企業軟體與工作系統設計', 'Enterprise software and work systems')],
  [t('核心領域', 'Core fields'), t('工作協作、資訊管理、存取治理', 'Work coordination, information management and access governance')],
  [t('服務內容', 'Services'), t('系統規劃、導入、資料遷移、訓練與維護支援', 'System planning, implementation, data migration, training and maintenance support')],
  [t('服務地區', 'Service region'), t('台灣', 'Taiwan')],
  [t('聯絡方式', 'Contact'), 'contact@eryndex.com'],
];
---

<Hero lang={lang} />

<main class="corporate-site">
  <section class="value-strip" aria-label={t('Eryndex 核心價值', 'Eryndex core values')}>
    <div class="wrap value-strip-grid">
      {values.map(([title, description], index) => (
        <article><span>0{index + 1}</span><h2>{title}</h2><p>{description}</p></article>
      ))}
    </div>
  </section>

  <section id="about" class="about-scene wrap scene">
    <div class="scene-label"><span>ABOUT ERYNDEX</span><span>{t('關於智序科技', 'About Eryndex')}</span></div>
    <div class="about-layout">
      <h2>{t('科技的價值，\n在於讓企業更有秩序地前進。', 'Technology matters when it helps business move forward with clarity.')}</h2>
      <div class="about-copy">
        <p class="lead">{t('Eryndex 智序科技專注於企業工作協作、資訊管理與存取治理系統的設計與開發。', 'Eryndex designs and develops systems for business coordination, information management and access governance.')}</p>
        <p>{t('我們從企業每天真正發生的工作出發，把分散的流程、重要資訊與管理規則整理成可以理解、可以執行，也可以持續改善的企業脈絡。', 'We begin with the work that actually happens every day, turning fragmented processes, important information and management rules into an operating context that can be understood, executed and continuously improved.')}</p>
      </div>
    </div>
    <div class="about-visual" aria-hidden="true">
      <MasterImage kind="space" alt="" sizes="(max-width: 700px) 92vw, 42vw" />
      <MasterImage kind="files" alt="" sizes="(max-width: 700px) 92vw, 42vw" />
      <MasterImage kind="shield" alt="" sizes="(max-width: 700px) 92vw, 42vw" />
    </div>
  </section>

  <section id="products" class="system-scene scene">
    <span id="products-space" class="legacy-anchor" aria-hidden="true"></span>
    <span id="products-files" class="legacy-anchor" aria-hidden="true"></span>
    <span id="products-shield" class="legacy-anchor" aria-hidden="true"></span>
    <div class="wrap system-layout">
      <div class="system-intro">
        <p class="eyebrow">ONE BUSINESS OPERATING SYSTEM</p>
        <h2>{t('不是更多產品，\n而是一套完整的企業運作方法。', 'Not more products.\nOne complete way for business to work.')}</h2>
        <p class="lead">{t('Eryndex 將工作、資訊與信任放進同一套清楚的系統主題。企業不必理解多個產品的差異，只需要從正在發生的問題開始。', 'Eryndex brings work, information and trust into one clear system. Businesses do not need to navigate separate products; they can begin with the problem in front of them.')}</p>
      </div>
      <div class="capability-stack">
        {capabilities.map(([title, description], index) => (
          <article><span>0{index + 1}</span><div><h3>{title}</h3><p>{description}</p></div></article>
        ))}
      </div>
    </div>
    <div class="system-statement wrap">
      <p>{t('讓工作留下脈絡，讓資訊可以延續，讓每一次授權與決策都有依據。', 'Keep the context of work, preserve the continuity of information and give every permission and decision a clear basis.')}</p>
    </div>
  </section>

  <section id="approach" class="process-scene wrap scene">
    <header class="scene-heading">
      <div><p class="eyebrow">HOW WE WORK</p><h2>{t('從理解企業，\n到系統穩定運作。', 'From understanding the business\nto a system that works reliably.')}</h2></div>
      <p>{t('我們不以功能清單開始，而是先確認工作如何發生、資訊如何流動，以及誰需要承擔管理責任。', 'We do not begin with a feature list. We first understand how work happens, how information moves and where management responsibility belongs.')}</p>
    </header>
    <ol class="process-list">
      {process.map(([title, description], index) => (
        <li><span>0{index + 1}</span><h3>{title}</h3><p>{description}</p></li>
      ))}
    </ol>
    <div class="service-callout">
      <p class="eyebrow">PROFESSIONAL SERVICES</p>
      <h3>{t('規劃、導入、遷移、訓練與持續支援。', 'Planning, implementation, migration, training and ongoing support.')}</h3>
      <p>{t('實際服務範圍會依企業環境、既有系統與專案需求共同確認。', 'Service scope is agreed around each business environment, existing system and project requirement.')}</p>
    </div>
  </section>

  <section id="company" class="company-scene scene">
    <div class="wrap company-layout">
      <div><p class="eyebrow">COMPANY PROFILE</p><h2>{t('清楚、正式、\n可以被理解的公司資訊。', 'Clear, formal and understandable company information.')}</h2></div>
      <dl class="company-facts">
        {companyFacts.map(([term, description]) => (
          <div><dt>{term}</dt><dd>{description === 'contact@eryndex.com' ? <a href="mailto:contact@eryndex.com">{description} ↗</a> : description}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section id="contact" class="contact-scene scene">
    <div class="wrap contact-layout">
      <div><p class="eyebrow">CONTACT ERYNDEX</p><h2>{t('需要公司、合作或系統相關資訊？', 'Need company, partnership or system information?')}</h2></div>
      <div><p>{t('歡迎透過官方信箱與智序科技聯絡。', 'Contact Eryndex through our official email address.')}</p><a href="mailto:contact@eryndex.com">contact@eryndex.com ↗</a><span>Taiwan · Asia/Taipei</span></div>
    </div>
  </section>

  <section class="wrap corporate-legal" aria-label={t('網站政策', 'Website policies')}>
    {['privacy', 'terms'].map((kind) => (
      <details id={kind}><summary><span>{kind === 'privacy' ? t('隱私權說明', 'Privacy notice') : t('網站使用條款', 'Website terms')}</span><span aria-hidden="true">＋</span></summary><Legal lang={lang} kind={kind} embedded /></details>
    ))}
  </section>
</main>

<script>
  function revealAnchor() {
    if (!location.hash) return;
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let node: HTMLElement | null = target;
    while (node) { if (node instanceof HTMLDetailsElement) node.open = true; node = node.parentElement; }
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }
  addEventListener('hashchange', revealAnchor);
  revealAnchor();
</script>
