---
import { translator, type Locale } from '../data/content';
import Hero from './Hero.astro';
import '../styles/single-page.css';

const { lang } = Astro.props as { lang: Locale };
const t = translator(lang);

const values = [
  [t('企業數位基礎', 'ENTERPRISE DIGITAL FOUNDATION'), t('依照營運方式設計系統', 'Systems shaped around operations'), t('從角色、流程與資料關係開始，建立真正符合團隊工作方式的企業軟體。', 'Start with roles, processes and data relationships to build software that reflects how teams actually work.')],
  [t('智慧工作整合', 'INTELLIGENT WORK INTEGRATION'), t('讓資訊與工具彼此連結', 'Connect information and tools'), t('整合既有服務、知識與自動化能力，減少重複輸入並保留完整工作脈絡。', 'Connect existing services, knowledge and automation to reduce duplicate work and preserve context.')],
  [t('可信任的營運', 'TRUSTED OPERATIONS'), t('讓管理與持續改善有依據', 'Govern and improve with evidence'), t('以版本、權限、核准與稽核紀錄，支援組織長期、安全且可追溯的運作。', 'Use versions, permissions, approvals and audit records to support secure, traceable operations over time.')],
];

const capabilities: Array<[string, string, string[]]> = [
  [
    t('智慧工作與協作', 'Intelligent work and collaboration'),
    t('把任務、知識與自動化放在同一條工作脈絡中，協助團隊清楚掌握責任、進度與下一步。', 'Bring tasks, knowledge and automation into one operating context so teams can clearly see ownership, progress and next actions.'),
    [t('任務與流程管理', 'Task and workflow management'), t('團隊知識與語意搜尋', 'Team knowledge and semantic search'), t('AI 輔助整理與回應', 'AI-assisted organization and responses'), t('通知、交接與決策紀錄', 'Notifications, handoffs and decision records')],
  ],
  [
    t('資訊資產與系統整合', 'Information assets and system integration'),
    t('以一致的保存、版本與連結方式管理企業資訊，並串接既有工具與服務，形成可持續使用的數位資產。', 'Manage enterprise information through consistent storage, versions and links while connecting existing tools into reusable digital assets.'),
    [t('文件與版本歷程', 'Documents and version history'), t('分享連結與跨部門協作', 'Shared links and cross-team collaboration'), t('API 與既有系統串接', 'API and legacy system integration'), t('備份、還原與資料遷移', 'Backup, restore and data migration')],
  ],
  [
    t('身分安全與治理', 'Identity, security and governance'),
    t('將身分、裝置、權限、核准與稽核整合成可管理的治理流程，讓每一次存取與變更都有依據。', 'Unify identity, devices, permissions, approvals and audit into manageable governance so every access and change has evidence.'),
    [t('身分與裝置管理', 'Identity and device management'), t('角色權限與存取核准', 'Role permissions and access approvals'), t('稽核紀錄與異常追蹤', 'Audit records and anomaly tracking'), t('資料保護與存取政策', 'Data protection and access policies')],
  ],
];

const process = [
  [t('理解企業現況', 'Understand the business context'), t('盤點真實工作、既有工具、資料來源與管理責任，辨識需要優先處理的問題。', 'Review real work, existing tools, data sources and ownership to identify the problems that matter first.')],
  [t('設計並連結系統', 'Design and connect the system'), t('將流程、資訊、AI 輔助與治理原則整理成可操作的系統，並依需求與既有服務整合。', 'Turn processes, information, AI assistance and governance into an operable system connected to existing services where needed.')],
  [t('導入與持續營運', 'Implement and operate'), t('透過資料遷移、教育訓練、版本管理與後續支援，讓新的工作方式穩定進入日常。', 'Use migration, enablement, version management and ongoing support to make the new way of working sustainable.')],
];

---

<Hero lang={lang} />

<main class="corporate-site">
  <section id="about" class="about-scene wrap scene">
    <div class="scene-label"><span>ABOUT ERYNDEX</span><span>{t('關於智序科技', 'About Eryndex')}</span></div>
    <div class="about-layout">
        <h2>{t('以企業每天的工作\n作為系統設計的起點', 'Enterprise systems designed around the work people actually do')}</h2>
      <div class="about-copy">
        <p class="lead">{t('Eryndex 智序科技是一家位於台灣的企業軟體與智慧工作系統設計公司。', 'Eryndex is a Taiwan-based enterprise software and intelligent work systems company.')}</p>
        <p>{t('我們從企業真實的營運流程出發，整合工作協作、資訊資產、AI 輔助與存取治理，將分散的工具與資料整理成團隊可以使用、管理並持續演進的系統。服務涵蓋需求釐清、系統規劃、既有服務串接、資料遷移、教育訓練與後續支援。', 'We begin with real operating processes, bringing together collaboration, information assets, AI assistance and access governance. The result is a system teams can use, manage and evolve. Services include discovery, system planning, integration, migration, enablement and ongoing support.')}</p>
        <div class="about-meta"><span>{t('服務地區', 'REGION')} · TAIWAN</span><span>{t('業務類型', 'FOCUS')} · B2B SOFTWARE</span></div>
      </div>
    </div>
  </section>

  <section class="value-strip" aria-label={t('Eryndex 核心價值', 'Eryndex core values')}>
    <div class="wrap value-strip-grid">
      {values.map(([category, title, description]) => (
        <article>
          <header><span>{category}</span></header>
          <h2>{title}</h2>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="products" class="system-scene scene">
    <span id="products-space" class="legacy-anchor" aria-hidden="true"></span>
    <span id="products-files" class="legacy-anchor" aria-hidden="true"></span>
    <span id="products-shield" class="legacy-anchor" aria-hidden="true"></span>
    <div class="wrap system-layout">
      <div class="system-intro">
        <div class="system-title">
          <p class="eyebrow">CORE CAPABILITIES</p>
          <h2>{t('三項能力\n支撐一套企業系統', 'Three capabilities\nOne enterprise system')}</h2>
        </div>
        <p class="lead">{t('三項能力不是彼此分離的產品，而是共同支撐企業工作、資訊與治理的一套系統基礎。', 'These capabilities are not isolated products. Together they form one system foundation for work, information and governance.')}</p>
      </div>
      <div class="capability-stack">
        {capabilities.map(([title, description, features], index) => (
          <article tabindex="0">
            <div class="capability-icon" aria-hidden="true">
              {index === 0 ? (
                <svg viewBox="0 0 24 24"><path d="M4 7h6M14 7h6M7 4v6M17 4v6M4 17h6M14 17h6M7 14v6M17 14v6M10 7h4v10h-4z" /></svg>
              ) : index === 1 ? (
                <svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v5h5M9 12h6M9 16h6" /></svg>
              ) : (
                <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.8-2.8 8.2-7 10-4.2-1.8-7-5.2-7-10V6zM9 12l2 2 4-4" /></svg>
              )}
            </div>
            <div class="capability-copy">
              <h3>{title}</h3>
              <p>{description}</p>
              <ul class="capability-features">
                {features.map((feature) => <li>{feature}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="approach" class="process-scene wrap scene">
    <header class="scene-heading">
      <div><p class="eyebrow">DELIVERY MODEL</p><h2>{t('從需求確認\n到系統穩定運作', 'From confirmed requirements\nto reliable operation')}</h2></div>
      <p>{t('我們不以功能清單開始，而是先確認工作如何發生、資訊如何流動，以及誰需要承擔管理責任。', 'We do not begin with a feature list. We first understand how work happens, how information moves and where management responsibility belongs.')}</p>
    </header>
    <ol class="process-list">
      {process.map(([title, description]) => (
        <li><h3>{title}</h3><p>{description}</p></li>
      ))}
    </ol>
  </section>

</main>

<script>
  function revealAnchor() {
    if (!location.hash) return;
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = document.getElementById(id);
    if (!target) return;
    let node: HTMLElement | null = target;
    while (node) { if (node instanceof HTMLDetailsElement) node.open = true; node = node.parentElement; }
    requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }
  addEventListener('hashchange', revealAnchor);
  revealAnchor();
</script>
