---
import { content, href, type Locale } from '../data/content';
import Hero from './Hero.astro';
import MasterImage from './MasterImage.astro';
import ProductUI from './ProductUI.astro';
import CTA from './CTA.astro';
const { lang } = Astro.props as { lang: Locale };
const { t, products, solutions, stages, articles } = content(lang);
---

<Hero lang={lang} />
<section id="proposition" class="proposition wrap section">
  <p class="eyebrow">A CLEARER WAY TO WORK</p><div>
    <h2>{t('科技的價值，\n在於讓人從容。', 'Better technology.\nMore room to be human.')}</h2><p
      class="lead"
    >
      {
        t(
          '企業的日常不只有一種挑戰。工作需要組織，資訊需要保存，信任需要管理。我們以三套各有所長的軟體，陪你建立更清楚的工作方式。',
          'Business has more than one kind of challenge. Work needs structure, information needs care, and trust needs boundaries. Three focused products help you build a clearer way of working.',
        )
      }
    </p>
  </div>
</section>
<section class="product-section wrap section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">THREE PRODUCTS. ONE THOUGHTFUL APPROACH.</p><h2>
        {t('各有所長，一起向前。', 'Distinct by purpose.\nConnected by design.')}
      </h2>
    </div><a class="text-link" href={href(lang, 'products')}
      >{t('認識所有產品', 'Explore all products')} ↗</a>
  </div>
  <div class="product-trio">
    {
      products.map((p, i) => (
        <article class={'product-teaser ' + p.accent}>
          <>
            <a
              class="product-art"
              href={href(lang, 'products/' + p.id)}
              aria-label={t('認識', 'Explore') + ' ' + p.name}
            >
              <MasterImage
                kind={p.id as 'space' | 'files' | 'shield'}
                alt={p.concept + ' — ' + p.name}
                sizes="(max-width: 600px) 100vw, 33vw"
              />
            </a>
            <div class="product-teaser-copy">
              <>
                <span class="product-index">
                  0{i + 1} / {p.concept}
                </span>
                <h3>
                  <a href={href(lang, 'products/' + p.id)}>
                    {p.name}
                    <span aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p class="product-summary">{p.short}</p>
                <p>{p.category}</p>
              </>
            </div>
          </>
        </article>
      ))
    }
  </div>
</section>
<section class="experience-home section wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow">FROM IDEAS TO EVERYDAY</p><h2>
        {t('好的設計，回到工作的細節。', 'Thoughtful design.\nPractical every day.')}
      </h2>
    </div><p>
      {t('每套產品，用適合問題的方式工作。', 'Each product works in the way its purpose requires.')}
    </p>
  </div><ProductUI lang={lang} id="space" /><div class="experience-links">
    {
      products.map((p) => (
        <a href={href(lang, 'products/' + p.id) + '#experience'}>
          <>
            <span class={'dot ' + p.accent} />
            <strong>{p.name}</strong>
            <span>
              {p.features[0][0]} · {p.features[1][0]}
            </span>
            <span aria-hidden="true">↗</span>
          </>
        </a>
      ))
    }
  </div>
</section>
<section class="solutions-home section wrap">
  <div class="section-heading">
    <div>
      <p class="eyebrow">BETTER TOGETHER</p><h2>
        {t('從你的情境，\n找到合適的組合。', 'Your situation.\nThe right combination.')}
      </h2>
    </div><p>
      {
        t(
          '可以從一套開始，也能讓彼此連結。選擇跟著需求走。',
          'Start with one product or connect several. Let your needs set the pace.',
        )
      }
    </p>
  </div><div class="solution-list">
    {
      solutions.map((s, i) => (
        <a href={href(lang, 'solutions/' + s.id)}>
          <>
            <span class="index">0{i + 1}</span>
            <h3>{s.name}</h3>
            <span class="combination">
              {s.ids.map((id) => (
                <span class={'pill ' + products.find((p) => p.id === id)!.accent}>
                  {products.find((p) => p.id === id)!.word}
                </span>
              ))}
            </span>
            <span aria-hidden="true">↗</span>
          </>
        </a>
      ))
    }
  </div>
</section>
<section class="service-band">
  <div class="wrap section">
    <p class="eyebrow">ERYNDEX SERVICES · PROFESSIONAL SERVICES</p><div class="service-intro">
      <h2>
        {
          t(
            '軟體只是開始。\n我們陪你真正落地。',
            'Software is the beginning.\nWe help make it work.',
          )
        }
      </h2><div>
        <p class="lead">
          {
            t(
              '從導入、遷移到訓練與維護，讓產品適合你的企業，也讓團隊有能力持續使用。',
              'From implementation and migration to training and maintenance, make the products fit your business and help your team keep using them well.',
            )
          }
        </p><a class="text-link" href={href(lang, 'services')}
          >{t('認識專業服務', 'Explore our services')} ↗</a>
      </div>
    </div><ol class="stages">
      {
        stages.map((s, i) => (
          <li>
            <>
              <span>0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </>
          </li>
        ))
      }
    </ol>
  </div>
</section>
<section class="wrap section why">
  <p class="eyebrow">WHY ERYNDEX</p><h2>
    {t('保留選擇，\n也留出成長的空間。', 'Keep your choices.\nMake room to grow.')}
  </h2><div class="principles">
    {
      [
        [
          t('獨立就有價值', 'Value on its own'),
          t(
            '每套產品解決明確的問題，依眼前需求選擇適合的起點。',
            'Each product solves a clear problem. Choose a starting point that matters now.',
          ),
        ],
        [
          t('以真實工作為中心', 'Grounded in real work'),
          t(
            '從日常流程出發，讓工具服務團隊的工作方式。',
            'Begin with everyday practices and let the tools support the team.',
          ),
        ],
        [
          t('有人一起落地', 'A partner in implementation'),
          t(
            '除了軟體，也提供導入、訓練與持續支援。',
            'Go beyond software with implementation, training and ongoing assistance.',
          ),
        ],
      ].map(([h, p]) => (
        <div>
          <>
            <h3>{h}</h3>
            <p>{p}</p>
          </>
        </div>
      ))
    }
  </div>
</section>
<section class="wrap section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">NOTES FOR BETTER WORK</p><h2>
        {t('從理解，開始改善。', 'Better work begins with understanding.')}
      </h2>
    </div><a class="text-link" href={href(lang, 'resources')}
      >{t('閱讀更多觀點', 'More ideas')} ↗</a>
  </div><div class="articles">
    {
      articles.map((a, i) => (
        <a href={href(lang, 'resources/' + a.id)}>
          <>
            <span class="eyebrow">
              0{i + 1} / {a.tag}
            </span>
            <h3>{a.title}</h3>
            <span class="text-link">{t('閱讀文章', 'Read article')} ↗</span>
          </>
        </a>
      ))
    }
  </div>
</section>
<CTA lang={lang} />
