---
import '../styles/global.css';
import '../styles/pages.css';
import ContactDialog from '../components/ContactDialog.astro';
import { locales, href, pageHref, asset, base, translator, type Locale } from '../data/content';
interface Props {
  lang: Locale;
  path?: string;
  singlePage?: boolean;
  title: string;
  description: string;
}
const { lang, path = '', title, description, singlePage = true } = Astro.props;
const t = translator(lang);
const sectionHref = (section = '') =>
  singlePage
    ? section
      ? href(lang, section)
      : '#main'
    : href(lang) + (section ? href(lang, section) : '');
const canonical = new URL(path && !singlePage ? pageHref(lang, path) : href(lang, path), Astro.site);
const nav = [
  ['about', t('關於智序', 'About')],
  ['products', t('企業系統', 'Business system')],
  ['approach', t('工作方法', 'Approach')],
];
const languageNames = { 'zh-tw': '繁體中文', 'zh-cn': '简体中文', en: 'English' };
const solutionHref = (slug: string) => `${base}/${lang}/solutions/${slug}/`;
---

<!doctype html>
<html lang={lang === 'zh-tw' ? 'zh-Hant' : lang === 'zh-cn' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Eryndex 智序科技</title><meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" /><link
      rel="icon"
      type="image/webp"
      href={asset('web/logo-72.webp')}
    />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l === 'zh-tw' ? 'zh-Hant' : l === 'zh-cn' ? 'zh-Hans' : 'en'}
          href={new URL(path && !singlePage ? pageHref(l, path) : href(l, path), Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(path && !singlePage ? pageHref('zh-tw', path) : href('zh-tw', path), Astro.site)} />
    <meta property="og:type" content="website" /><meta
      property="og:title"
      content={title + ' · Eryndex'}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:site_name" content="Eryndex 智序科技" /><meta
      property="og:locale"
      content={lang === 'zh-tw' ? 'zh_TW' : lang === 'zh-cn' ? 'zh_CN' : 'en_US'}
    />
    <meta property="og:image" content={new URL(asset('web/hero-social.png'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('Eryndex 智序科技網站 Hero', 'Eryndex hero')} />
    <meta name="twitter:image" content={new URL(asset('web/hero-social.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title + ' · Eryndex'}
    /><meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('eryndex-theme'); } catch {}
        const theme = saved === 'dark' || saved === 'light' ? saved : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('跳至主要內容', 'Skip to content')}</a>
    <header class="site-header">
      <a class="brand" href={sectionHref()} aria-label={t('Eryndex 智序科技首頁', 'Eryndex home')}
        ><span class="brand-mark"
          ><img src={asset('web/logo-72.webp')} alt="" width="36" height="36" /></span
        ><span>Eryndex<span class="brand-cn">{t('智序科技', '')}</span></span></a
      >
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav"
        >{t('選單', 'Menu')} <span aria-hidden="true">☰</span></button
      >
      <nav id="site-nav" aria-label={t('主要導覽', 'Main navigation')}>
        {
          nav.map(([p, label]) => (
            <a
              href={sectionHref(p)}
              aria-current={path === p || path.startsWith(p + '/') ? 'page' : undefined}
            >
              {label}
            </a>
          ))
        }
        <a class="nav-contact" href="#contact-dialog" data-contact-open
          >{t('聯絡我們', 'Contact')} <span aria-hidden="true">↗</span></a
        >
      </nav>
      <button class="theme-toggle" type="button" aria-label={t('切換明暗模式', 'Toggle light and dark mode')} aria-pressed="false">
        <span class="theme-toggle-track" aria-hidden="true"><span class="theme-toggle-thumb"></span></span>
        <span class="theme-toggle-label theme-label-light">{t('亮', 'Light')}</span>
        <span class="theme-toggle-label theme-label-dark">{t('暗', 'Dark')}</span>
      </button>
      <details class="language">
        <summary
          aria-label={(lang === 'en' ? 'EN' : lang === 'zh-tw' ? '繁' : '简') +
            ' — ' +
            t('切換語言', 'Change language')}
          ><span aria-hidden="true">◎</span>
          {lang === 'en' ? 'EN' : lang === 'zh-tw' ? '繁' : '简'}</summary
        ><div>
          {
            locales.map((l) => (
              <a
                data-language
                href={href(l)}
                lang={l}
                aria-current={lang === l ? 'true' : undefined}
              >
                {languageNames[l]}
              </a>
            ))
          }
        </div>
      </details>
    </header>
    <canvas class="theme-network" aria-hidden="true"></canvas>
    <main id="main" tabindex="-1"><slot /></main>
    <footer id="contact" class="footer">
      <div class="footer-main">
        <div class="footer-identity">
          <a class="brand" href={sectionHref()}>Eryndex</a>
          <strong>{t('智序科技', 'Enterprise work systems')}</strong>
          <p>{t('企業軟體與工作系統設計', 'Enterprise software and work systems')}</p>
          <a class="footer-primary-email" href="mailto:contact@eryndex.com">contact@eryndex.com ↗</a>
        </div>
        <div class="footer-links">
          <div>
            <span>{t('核心能力', 'Core capabilities')}</span>
            <a href={solutionHref('ai-solution-design')}>{t('AI 解決方案設計', 'AI solution design')}</a>
            <a href={solutionHref('enterprise-digital-infrastructure')}>{t('企業數位基礎架構', 'Enterprise digital infrastructure')}</a>
            <a href={solutionHref('zero-trust-access-governance')}>{t('零信任存取治理', 'Zero trust access governance')}</a>
          </div><div>
            <span>{t('公司', 'Company')}</span>
            <a href={sectionHref('about')}>{t('關於智序科技', 'About Eryndex')}</a>
            <a href={sectionHref('approach')}>{t('工作方法', 'How we work')}</a>
          </div><div>
            <span>{t('聯絡', 'Contact')}</span>
            <a href="#contact-dialog" data-contact-open>{t('聯絡我們', 'Contact us')}</a>
            <a href="mailto:contact@eryndex.com">contact@eryndex.com</a>
            <span class="footer-location">Taiwan · Asia/Taipei</span>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span
          >© {new Date().getFullYear()} Eryndex {
            t('智序科技。保留所有權利。', 'All rights reserved.')
          }</span
        ><div>
          <span>{t('官方網站', 'Official website')}</span>
          <a href="#main">{t('回到頂端', 'Back to top')} ↑</a>
        </div>
      </div>
    </footer>
    <ContactDialog lang={lang} />
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      const applyTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        themeToggle?.setAttribute('aria-pressed', String(theme === 'dark'));
        themeColor?.setAttribute('content', theme === 'dark' ? '#030712' : '#f8fafc');
        try { localStorage.setItem('eryndex-theme', theme); } catch {}
        window.dispatchEvent(new CustomEvent('eryndex-theme-change', { detail: theme }));
      };
      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle?.addEventListener('click', () => {
        applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });
      menu?.addEventListener('click', () => {
        const on = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(on));
        nav?.classList.toggle('is-open', on);
      });
      nav?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) {
          menu?.setAttribute('aria-expanded', 'false');
          nav.classList.remove('is-open');
        }
      });
      const preserveLanguageAnchor = () =>
        document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
          const url = new URL(link.href);
          url.hash = location.hash;
          link.href = url.href;
        });
      preserveLanguageAnchor();
      window.addEventListener('hashchange', preserveLanguageAnchor);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (menu?.getAttribute('aria-expanded') === 'true') {
            menu.setAttribute('aria-expanded', 'false');
            nav?.classList.remove('is-open');
            menu.focus();
          }
          document.querySelectorAll<HTMLDetailsElement>('.language[open]').forEach((x) => {
            x.open = false;
            x.querySelector<HTMLElement>('summary')?.focus();
          });
        }
      });
      document.addEventListener('click', (e) => {
        const language = document.querySelector<HTMLDetailsElement>('.language');
        if (language && !language.contains(e.target as Node)) language.open = false;
      });
      const mq = matchMedia('(prefers-reduced-motion: reduce)');
      if (!mq.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries)
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
          },
          { threshold: 0.08 },
        );
        document.querySelectorAll('.section').forEach((e) => observer.observe(e));
      }

      const canvas = document.querySelector<HTMLCanvasElement>('.theme-network');
      const context = canvas?.getContext('2d');
      if (canvas && context) {
        let width = 0;
        let height = 0;
        let frame = 0;
        const particles = Array.from({ length: Math.min(Math.floor(innerWidth / 32), 34) }, () => ({
          x: Math.random(),
          y: Math.random(),
          vx: (Math.random() - 0.5) * 0.00013,
          vy: (Math.random() - 0.5) * 0.00013,
          size: 1 + Math.random() * 1.4,
        }));
        const resizeCanvas = () => {
          const ratio = Math.min(devicePixelRatio || 1, 2);
          width = innerWidth;
          height = innerHeight;
          canvas.width = Math.round(width * ratio);
          canvas.height = Math.round(height * ratio);
          canvas.style.width = width + 'px';
          canvas.style.height = height + 'px';
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
        };
        const renderNetwork = () => {
          context.clearRect(0, 0, width, height);
          const dark = document.documentElement.dataset.theme === 'dark';
          for (let i = 0; i < particles.length; i += 1) {
            const a = particles[i];
            const ax = a.x * width;
            const ay = a.y * height;
            for (let j = i + 1; j < particles.length; j += 1) {
              const b = particles[j];
              const bx = b.x * width;
              const by = b.y * height;
              const distance = Math.hypot(ax - bx, ay - by);
              if (distance < 145) {
                context.beginPath();
                context.strokeStyle = dark
                  ? `rgba(56,189,248,${0.13 * (1 - distance / 145)})`
                  : `rgba(2,132,199,${0.12 * (1 - distance / 145)})`;
                context.lineWidth = 0.8;
                context.moveTo(ax, ay);
                context.lineTo(bx, by);
                context.stroke();
              }
            }
            context.beginPath();
            context.arc(ax, ay, a.size, 0, Math.PI * 2);
            context.fillStyle = dark ? 'rgba(56,189,248,0.42)' : 'rgba(2,132,199,0.3)';
            context.fill();
            if (!mq.matches) {
              a.x += a.vx;
              a.y += a.vy;
              if (a.x < 0 || a.x > 1) a.vx *= -1;
              if (a.y < 0 || a.y > 1) a.vy *= -1;
            }
          }
          if (!mq.matches) frame = requestAnimationFrame(renderNetwork);
        };
        const restartNetwork = () => {
          cancelAnimationFrame(frame);
          renderNetwork();
        };
        resizeCanvas();
        restartNetwork();
        addEventListener('resize', () => { resizeCanvas(); restartNetwork(); }, { passive: true });
        addEventListener('eryndex-theme-change', restartNetwork);
      }
    </script>
  </body>
</html>
